{
  "name": "@bryntum/pdf-export-server",
  "version": "3.0.1",
  "description": "Standalone PDF export server",
  "keywords": [
    "bryntum",
    "pdf",
    "png",
    "export",
    "server"
  ],
  "homepage": "https://github.com/bryntum/pdf-export-server",
  "bugs": {
    "url": "https://github.com/bryntum/pdf-export-server/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Bryntum",
    "url": "https://bryntum.com",
    "email": "info@bryntum.com"
  },
  "bin": {
    "pdf-export-server": "./bin/pdf-export-server"
  },
  "repository": {
    "type": "git",
    "url": "github:bryntum/pdf-export-server"
  },
  "scripts": {
    "start": "node ./src/server.js",
    "test": "node --no-deprecation ./node_modules/jest/bin/jest.js",
    "measure": "node ./src/utils/measure-export-time.js",
    "build": "node ./build.js",
    "build:win": "node ./build.js --platform=windows",
    "build:linux": "node ./build.js --platform=linux",
    "build:macos": "node ./build.js --platform=macos"
  },
  "dependencies": {
    "@muhammara/native": "~7.2.4",
    "@types/express": "~5.0.0",
    "body-parser": "~1.20.6",
    "command-line-args": "~6.0.1",
    "command-line-usage": "~7.0.3",
    "express": "~4.22.1",
    "express-request-id": "~3.0.0",
    "join-images": "~1.1.5",
    "memory-streams": "~0.1.3",
    "mkdirp": "~0.5.6",
    "nanoid": "~3.3.18",
    "puppeteer": "^25.4.0",
    "serve-static": "~1.16.2",
    "winston": "~3.2.1",
    "winston-daily-rotate-file": "~4.4.1",
    "ws": "~8.23.0"
  },
  "devDependencies": {
    "@babel/preset-env": "~7.29.7",
    "@yao-pkg/pkg": "~6.6.0",
    "jest": "~30.4.2",
    "move-file": "~1.0.0",
    "rimraf": "~2.6.2"
  },
  "overrides": {
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "brace-expansion": "5.0.13",
    "browserslist": "4.29.0",
    "glob": "14.0.2",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "minimatch": "11.0.1",
    "picomatch": "4.0.4",
    "qs": "6.16.1",
    "sharp": "0.35.5",
    "tar": "7.5.22",
    "uuid": "14.0.0",
    "@xmldom/xmldom": "0.9.12"
  },
  "engines": {
    "node": ">=24"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/host_resources/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/host_resources/"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/jest.setup.js"
    ],
    "globalSetup": "<rootDir>/__tests__/globalSetup.js",
    "globalTeardown": "<rootDir>/__tests__/globalTeardown.js",
    "transformIgnorePatterns": [
      "node_modules/(?!(express-request-id|nanoid|command-line-args|command-line-usage|uuid|puppeteer|puppeteer-core|@puppeteer/browsers|chromium-bidi|yargs)/)"
    ]
  },
  "pkg": {
    "assets": [
      "node_modules/@muhammara/native/binding/napi-v8/muhammara.node"
    ],
    "ignore": [
      "**/*.c",
      "**/*.cpp",
      "**/*.h"
    ]
  },
  "allowScripts": {
    "@muhammara/native": true
  }
}
